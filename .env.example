# --- Telegram ---
BOT_TOKEN=123456:ABC-your-bot-token
ADMIN_IDS=123456789

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///bot.db

# --- Polling / webhook ---
# POLLING_MODE=true — запуск через long polling (для dev).
# false — webhook (aiohttp) + HTTPS через Caddy.
POLLING_MODE=true
WEBHOOK_HOST=https://bot.example.com
WEBHOOK_PATH=/telegram
WEBHOOK_SECRET_TOKEN=change-me-secret

# --- Remnawave 2.7.x ---
REMNAWAVE_API_URL=https://panel.example.com
REMNAWAVE_USERNAME=admin
REMNAWAVE_PASSWORD=change-me
# Поддомен, на котором панель отдаёт подписки (/sub/{shortUuid}).
REMNAWAVE_SUB_URL=https://panel.example.com
# Тег reality-inbound, из которого выдавать конфиги (опционально).
REMNAWAVE_INBOUND_TAG=

# --- Деньги / рефералка ---
CURRENCY=RUB
REFERRAL_PERCENT=10
SUPPORT_LINK=https://t.me/your_support

# --- Trial ---
TRIAL_ENABLED=true
TRIAL_DAYS=3
TRIAL_GB=5
TRIAL_DEVICES=1

# --- ЮKassa (карты/СБП) ---
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- CryptoBot (Crypto Pay) ---
CRYPTOBOT_ENABLED=false
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_WEBHOOK_SECRET=

# --- RollyPay ---
ROLLYPAY_ENABLED=false
ROLLYPAY_API_URL=https://api.rollypay.com
ROLLYPAY_API_KEY=
ROLLYPAY_SECRET=

# --- Уведомления ---
NOTIFY_BEFORE_DAYS=3,1
NOTIFY_TRAFFIC_PERCENT=80
